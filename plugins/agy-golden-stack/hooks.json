{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m agy_golden_stack.cli dispatch SessionStart --json",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m agy_golden_stack.cli dispatch PreToolUse --json",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m agy_golden_stack.cli dispatch PostToolUse --json",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
